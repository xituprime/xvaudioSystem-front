# =============================================================================
# PLANTILLA — Vite NO lee .env.example al arrancar.
# Copia este archivo a ".env" en la misma carpeta y edita los valores ahí.
# =============================================================================

VITE_API_URL=/api

# URL del backend en producción o Render.
# Ejemplo:
# VITE_API_URL=https://xvaudiosystem-back.onrender.com
# Si tu API usa prefijo /api en las rutas:
# VITE_API_URL=https://xvaudiosystem-back.onrender.com/api

# Si quieres usar un proxy local para desarrollo, define la URL completa del backend local:
# VITE_DEV_API_URL=http://<tu-backend-local>:5000
# VITE_API_URL=/api

# Si el backend local NO usa prefijo /api en las rutas (todo sin /api):
# VITE_PROXY_STRIP_API=true

# Si el perfil no está en /users/me (ruta relativa a VITE_API_URL, ej. /profile → /api/profile):
# VITE_API_USER_ME=/profile

# Si las cotizaciones no están bajo /quotes:
# VITE_API_QUOTES_BASE=/cotizaciones
